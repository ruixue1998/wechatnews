      <description>&lt;p style=&quot;font-size: 80%; letter-spacing: .001rem; font-size: .875rem;line-height: 1.375rem; margin-bottom: 5%;margin: 0!important; padding: 0 0 28px!important; line-height: 1.375rem&quot;&gt;
&lt;img alt=&quot;Image&quot; decoding=&quot;async&quot; src=&quot;https://s3.ifanr.com/wp-content/uploads/2026/11/ifanr-1795651252030-22.jpg!720&quot; style=&quot;display: block; max-width: 100%; height: auto; border-radius: clamp(8px, 2.8vw, 33px); corner-shape: superellipse(2.321928);&quot;/&gt;
